{% extends "base.twig" %}

{% block content %}
    <div class="row">
        <h2>Benvenuto in BudgetControl, {{user_name}}!</h2>
        <p>Grazie per esserti registrato. Per iniziare a gestire il tuo budget, devi confermare il tuo indirizzo email.</p>
    </div>

    <div class="row text-center">
        <a href="{{confirm_link}}" class="button">Conferma Email</a>
    </div>

    <div class="row mt-5">
        <p><strong>Cosa puoi fare con BudgetControl:</strong></p>
        <ul>
            <li>Tracciare entrate e spese quotidiane</li>
            <li>Visualizzare grafici e report dettagliati</li>
            <li>Impostare obiettivi di risparmio personalizzati</li>
            <li>Ricevere notifiche per budget e scadenze</li>
        </ul>
    </div>

    <div class="row">
        <p><small>Questo link è valido per 10 minuti. Se hai problemi, contatta il nostro supporto.</small></p>
    </div>
{% endblock %}