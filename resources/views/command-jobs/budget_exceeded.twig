{% extends "base.twig" %}

    {% block content %}
        <div class="row">
            <h2>⚠️ Budget Superato</h2>
            <p>Ciao {{user_name}},</p>
            <p>Il tuo budget <strong>"{{budgetName}}"</strong> ha superato il limite impostato.</p>
        </div>

        <div class="budget-info">
            <span><b>Budget impostato:</b> {{budgetAmount}} {{currency}}</span>
            <span><b>Totale speso:</b> {{totalSpent}} {{currency}}</span>
            <span><b>Rimanente:</b> {{totalRemaining}} {{currency}}</span>
            <span><b>Percentuale utilizzata:</b> {{spentPercentage}}</span>
        </div>

        <div class="row">
            <p>Ti consigliamo di rivedere le tue spese o di aggiornare il limite del budget se necessario.</p>
        </div>
    {% endblock %}

    {% block styles %}


        .budget-label {
            color: #065F46;
            display: inline-block;
            text-transform: uppercase;
            font-weight: bolder;
        }

        .total-spent, .spent-percentage {
            color: #065F46;
            font-weight: bold;
        }

        .progress-container {
            margin-top: 10px;
            background-color: #E5E7EB;
            overflow: hidden;
        }

    {% endblock %}

